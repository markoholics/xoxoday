# Required: Claude vision
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Database. Locally this defaults to file:./data/calorie.db.
# On Vercel use a free Turso (hosted SQLite/libSQL) database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: require this passphrase to use the app (recommended for a public URL)
APP_PASSWORD=
